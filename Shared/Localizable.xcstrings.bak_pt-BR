    "privacy.body": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不用注册，没有广告或分析工具。心情、备注和色卡只存在本机，不会自动备份到 iCloud。你可主动导出历史或分享色卡。分享图片默认隐藏日期，始终不含备注。通知只在你开启后使用；购买和恢复由 App Store 处理。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No account, ads, or analytics. Moods, notes, and palettes stay on this device and are excluded from automatic iCloud backups. You can export your history or share palettes yourself. Cards hide dates by default and never include notes. Reminders are opt-in; the App Store handles purchases and restoration."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不用註冊，沒有廣告或分析工具。心情、備註和色卡只儲存在本機，不會自動備份到 iCloud。你可主動匯出歷史或分享色卡。分享圖片預設隱藏日期，且不含備註。通知只在你開啟後使用；購買和回復由 App Store 處理。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウント、広告、分析ツールはありません。気分、メモ、パレットはこの端末内に保存され、iCloudの自動バックアップの対象外です。履歴の書き出しやパレットの共有はご自身で行えます。カードは初期設定で日付を表示せず、メモは一切含みません。通知はオンにした場合のみ届きます。購入と復元はApp Storeが処理します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정, 광고, 분석이 없습니다. 기분, 메모, 팔레트는 이 기기에만 남고 iCloud 자동 백업에서도 빠집니다. 기록 내보내기와 팔레트 공유는 직접 할 수 있습니다. 카드는 기본으로 날짜를 숨기고 메모는 절대 넣지 않습니다. 알림은 원할 때만 켜집니다. 구매와 복원은 App Store가 처리합니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Konto, keine Werbung, keine Analyse. Stimmungen, Notizen und Paletten bleiben auf diesem Gerät und sind vom automatischen iCloud-Backup ausgenommen. Verlauf exportieren und Paletten teilen kannst du selbst. Karten blenden Daten standardmäßig aus und enthalten nie Notizen. Erinnerungen sind optional; Käufe und Wiederherstellung laufen über den App Store."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin cuenta, sin anuncios, sin analíticas. Los ánimos, notas y paletas se quedan en este dispositivo y no entran en las copias automáticas de iCloud. Tú decides si exportas el historial o compartes paletas. Las tarjetas ocultan las fechas por defecto y nunca incluyen notas. Los recordatorios son opcionales; el App Store gestiona compras y restauración."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas de compte, de publicité ni d’analyse. Humeurs, notes et palettes restent sur cet appareil et sont exclues des sauvegardes iCloud automatiques. Tu peux exporter ton historique ou partager tes palettes toi-même. Les cartes masquent les dates par défaut et n’incluent jamais les notes. Les rappels sont facultatifs ; l’App Store gère les achats et les restaurations."
          }
        }
      }
    },
